<?xml version="1.0" encoding="UTF-8"?>
<configuration> 
    <input>
        <net-file value="cuenca.net.xml"/>
        <route-files value="cuenca.rou.xml"/>
        <additional-files value="cuenca.poly.xml"/>
    </input>

    <!-- Sin salidas: ns-3 no las necesita y co2/fcd pesaban 30 MB por corrida.
         Para emisiones/FCD usa cuenca_salidas.sumocfg -->
<processing>
        <ignore-route-errors value="true"/>
    </processing>    
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
</configuration> 
